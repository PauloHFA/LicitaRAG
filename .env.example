# Aplicação
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=sua-chave-secreta-para-licita-rag

# Banco de Dados (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=licitarag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/licitarag
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/licitarag

# Cache e Fila de Tarefas (Redis)
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Local e Nuvem Gratuita)
DEFAULT_LLM_PROVIDER=groq # groq ou ollama
GROQ_API_KEY=gsk_sua_chave_groq_aqui
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embeddings e Reranking
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=cpu # cpu ou cuda

# Armazenamento e Ingestão
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50
